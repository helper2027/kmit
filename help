          "aws:SourceArn":"arn:aws:sns:us-east-1:905418062728:MyTopic2"
        }
      }
    }
  ]
}



def lambda_handler(event, context):

    for record in event['Records']:
        print("Message received from SQS:")
        print(record['body'])

    return {
        'statusCode': 200,
        'body': 'Message processed successfully'
    }


